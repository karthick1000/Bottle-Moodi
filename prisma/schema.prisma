generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id         Int            @id @default(autoincrement())
  slug       String         @unique
  title      String
  tamil      String
  tag        String
  base       Int
  sub        String
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  orderItems OrderItem[]
  cartItems  CartItem[]
  images     ProductImage[]

  @@index([active])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Address {
  id          Int      @id @default(autoincrement())
  clerkUserId String
  name        String
  phone       String
  line1       String
  city        String
  pincode     String
  createdAt   DateTime @default(now())
  orders      Order[]

  @@index([clerkUserId])
}

model Payment {
  id                Int      @id @default(autoincrement())
  razorpayOrderId   String   @unique
  razorpayPaymentId String   @unique
  razorpaySignature String
  amountPaise       Int
  currency          String   @default("INR")
  createdAt         DateTime @default(now())
  order             Order?
}

model Order {
  id             Int         @id @default(autoincrement())
  clerkUserId    String
  status         OrderStatus @default(PENDING)
  shipping       Int         @default(79)
  discountCode   String?
  discountAmount Int         @default(0)
  notes          String?
  addressId      Int
  paymentId      Int?        @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  address        Address     @relation(fields: [addressId], references: [id])
  payment        Payment?    @relation(fields: [paymentId], references: [id])

  @@index([clerkUserId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  size      String
  amount    Int
  unitPrice Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model CartItem {
  id          Int      @id @default(autoincrement())
  clerkUserId String
  productId   Int
  size        String
  amount      Int
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clerkUserId, productId, size])
}

/// Key/value store for editable site content (hero copy, studio photo, ...).
/// Keeps homepage customisation out of the codebase so the admin can change
/// it without a deploy.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}

model DiscountCode {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  type      DiscountType
  value     Int
  minOrder  Int?
  maxUses   Int?
  usedCount Int          @default(0)
  active    Boolean      @default(true)
  expiresAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum DiscountType {
  PERCENT
  FLAT
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}
