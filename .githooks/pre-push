#!/bin/sh
# Block direct pushes to main — always use a feature branch + PR.

while read local_ref local_sha remote_ref remote_sha; do
  if echo "$remote_ref" | grep -q "refs/heads/main"; then
    echo ""
    echo "  ✗  Direct push to 'main' is blocked."
    echo "     Create a feature branch and open a PR instead:"
    echo ""
    echo "     git checkout -b feature/your-change"
    echo "     git push -u origin feature/your-change"
    echo "     gh pr create --base main"
    echo ""
    exit 1
  fi
done

exit 0
